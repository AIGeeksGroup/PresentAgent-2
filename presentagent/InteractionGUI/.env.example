# =============================================================================
# PresentAgent-2 InteractionGUI Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
# IMPORTANT: Never commit .env to version control.

# ---------------------------------------------------------------------------
# LLM API Configuration (OpenAI-compatible)
# ---------------------------------------------------------------------------
ANTHROPIC_AUTH_TOKEN=your_api_key_here
ANTHROPIC_PROVIDER=your_provider_here
ANTHROPIC_BASE_URL=https://api.example.com/v1
ANTHROPIC_MODEL=your_model_name
ANTHROPIC_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# TTS Voice
# ---------------------------------------------------------------------------
# Voice name for speech synthesis
TTS_VOICE=default

# ---------------------------------------------------------------------------
# Knowledge Base
# ---------------------------------------------------------------------------
# Path to the source document (source.md or slide_notes.json)
SOURCE_MD_PATH=./source/202605032000/source.md

# ---------------------------------------------------------------------------
# Directories
# ---------------------------------------------------------------------------
# Audio output directory (auto-created at runtime)
TTS_OUTPUT_DIR=./tts_output

# Sentence embedding cache directory
CACHE_DIR=./.cache

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
# Base URL for constructing audio URLs (change if behind a reverse proxy)
# Defaults to localhost:8000 for local development
API_BASE_URL=http://localhost:8000
